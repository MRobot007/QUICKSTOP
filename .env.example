# ─────────────────────────────────────────────────────────────────────────────
# Environment variables
#
# Everything has a working local default, so a fresh clone needs no setup
# beyond `npm install`. Copy this to .env.local only if you want to override
# something.
#
# Two of these are not optional once the store is reachable by anyone but you —
# see "Before you put this on a network" at the bottom.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (Next.js) ──
# Where the browser reaches the PHP API. `npm run api` serves it on port 8080.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080/api

# ── Backend (PHP API) ──
# The whole store lives in one SQLite file. It is created and seeded with the
# demo catalog on the first request; delete it to reset the store.
# DB_FILE=./api/data/quickstop.sqlite

# Store timezone. Leave unset to follow this machine's clock.
# APP_TIMEZONE=America/Chicago

# GST charged on a product whose category has no rate of its own. Per-category
# rates are set in the app under Admin → GST & Tax.
# DEFAULT_GST_RATE=8.25

# Receipt paper width in millimetres: 80 for most Epson TM models (T20, T82,
# T88, M30), 58 for the narrow and mobile ones. Restart after changing.
# NEXT_PUBLIC_RECEIPT_WIDTH_MM=80

# How long the sign-in screen waits before reporting the API unreachable.
# The default suits a backend on a free tier that sleeps when idle and takes
# most of a minute to wake. Lower it for an always-on backend.
# NEXT_PUBLIC_HEALTH_TIMEOUT_MS=45000

# ── Security ──
# Trading name printed on receipts, report headers and purchase-order emails.
# Each shop sets its own; the default is an obvious placeholder.
# NEXT_PUBLIC_SHOP_NAME=Demo Store

# Signs the login tokens. Left unset, one is generated on first run and kept in
# api/data/.token_secret. Set it explicitly when more than one server has to
# accept the same tokens. Changing it signs everyone out.
# TOKEN_SECRET=
# TOKEN_TTL_HOURS=168

# Password of the two seeded logins. Left unset, one is generated on first run
# and written to api/data/FIRST-RUN-PASSWORD.txt — read it, change both
# passwords under Admin → Users, then delete the file.
# SEED_PASSWORD=

# Failed sign-ins allowed for one account from one address before further
# attempts are refused for the rest of the window.
# LOGIN_MAX_ATTEMPTS=8
# LOGIN_WINDOW_MINUTES=15
# PASSWORD_MIN_LENGTH=8

# CORS allowlist: exact origins, comma-separated. The "*" default allows
# loopback only, which is what the Next dev server on another port needs.
# ALLOWED_ORIGINS=*

# ─────────────────────────────────────────────────────────────────────────────
# Before you put this on a network
#
#   1. ALLOWED_ORIGINS — name the exact origin the app is served from, e.g.
#      https://pos.yourshop.com. Without it the browser blocks every call from
#      anywhere other than localhost.
#   2. TOKEN_SECRET — set it, or make sure api/data/ is writable so the server
#      can keep the generated one. A secret that changes on each boot signs
#      every till out on every restart.
#   3. Serve over HTTPS. Tokens ride in the Authorization header.
#   4. Confirm api/data/ is not downloadable: requesting
#      https://your-host/api/data/quickstop.sqlite must not return the file.
#      api/.htaccess denies it on Apache; on nginx add the equivalent
#      `location ~ /data/ { deny all; }`.
# ─────────────────────────────────────────────────────────────────────────────
